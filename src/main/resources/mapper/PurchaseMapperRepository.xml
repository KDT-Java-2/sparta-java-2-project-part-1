<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
  namespace=" com.sparta.commerce_project_01.domain.purchase.repository.PurchaseMapperRepository">

  <select id="findPurchaseWithPagination"
    parameterType="com.sparta.commerce_project_01.domain.purchase.dto.PurchaseSearchCondition"
    resultType="com.sparta.commerce_project_01.domain.purchase.dto.SearchUserDto">
    SELECT id,
    user_id,
    quantity,
    status,
    total_price,
    created_at
    FROM purchase
    <where>
      <if test="status != null and status != ''">
        AND status = #{status}
      </if>
      <if test="user_id != null">
        AND user_id = #{userId}
      </if>
    </where>
    ORDER BY created_at DESC
    LIMIT #{limit} OFFSET #{offset}
  </select>

</mapper>